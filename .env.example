# GEMINI_API_KEY: Optional Gemini API key if AI extensions are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for external database deployment.
# When omitted, TITAN uses its built-in persistent local JSON data store.
MONGODB_URI=

# STRIPE_SECRET_KEY: Optional Stripe secret key for live payment processing.
# When omitted, checkout runs in clearly labelled Test Mode.
STRIPE_SECRET_KEY=

# RAZORPAY_KEY_SECRET: Optional Razorpay secret key for live payment processing.
RAZORPAY_KEY_SECRET=
